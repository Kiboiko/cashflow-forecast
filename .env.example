# Скопируйте в .env и поменяйте значения. Без .env всё запускается на безопасных для разработки значениях по умолчанию.
# .env в репозиторий не попадает.

POSTGRES_USER=kassa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kassa

# Секрет подписи JWT: минимум 32 символа, случайный. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Адреса фронта, которым разрешён доступ к API (через запятую)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Вход персоны одним нажатием и «машина времени» (для жюри). В боевой среде — false.
DEMO_MODE=true

# Уведомления в Telegram (необязательно). Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Ключевая ставка (доля), которую показываем, если сайт ЦБ недоступен. На 23.10.2026 она 14%.
CBR_KEY_RATE_FALLBACK=0.14
